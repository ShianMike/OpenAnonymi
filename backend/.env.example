# Copy this file to .env and set values for your local PostgreSQL instance.
# Do not use these placeholders as production credentials.
PRIVACY_REVIEW_DATABASE_URL=postgresql+psycopg://review:change-me@127.0.0.1:5432/review
PRIVACY_REVIEW_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PRIVACY_REVIEW_ENVIRONMENT=development
# Before enabling document intake, generate a Fernet key outside this repository
# and set both variables. Example command:
# .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PRIVACY_REVIEW_ACTIVE_KEY_ID=local-v1
# PRIVACY_REVIEW_CONTENT_KEYS={"local-v1":"REPLACE_WITH_GENERATED_FERNET_KEY"}

# Optional account recovery: configure all four SMTP values to enable email delivery.
# Use an SMTP-over-TLS endpoint (default port 465). Without these, recovery reports unavailable.
# PRIVACY_REVIEW_SMTP_HOST=smtp.example.invalid
# PRIVACY_REVIEW_SMTP_PORT=465
# PRIVACY_REVIEW_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
# PRIVACY_REVIEW_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# PRIVACY_REVIEW_SMTP_FROM=review@example.invalid
# When false, the sign-up form explains that account creation is closed.
# Existing sign-in and operator bootstrap continue to work.
PRIVACY_REVIEW_REGISTRATION_ENABLED=true

# Number of reverse proxies in front of the API that append to X-Forwarded-For.
# 0 (default) ignores the header and uses the socket peer. Behind a host proxy, set the
# measured value (see README "Production hosting"); attempt limits key on that address.
# PRIVACY_REVIEW_TRUSTED_PROXY_HOPS=0
# PostgreSQL connect timeout in seconds (2-60). Raise it for databases that suspend when idle.
# PRIVACY_REVIEW_DATABASE_CONNECT_TIMEOUT=2

# ---------------------------------------------------------------------------------------
# Production template. Set these in the host's secret store, never in a committed file.
# The website (Vercel) and API (container host) are different origins, so the session
# cookie is issued as HttpOnly; Secure; SameSite=None; Partitioned in production.
# PRIVACY_REVIEW_ENVIRONMENT=production
# Remote production databases require verified TLS. Use the host's trusted CA:
# Supabase (bundled public CA): sslrootcert=/app/certs/supabase-ca.crt
# Publicly trusted servers: sslrootcert=system
# PRIVACY_REVIEW_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full&sslrootcert=/app/certs/supabase-ca.crt
# PRIVACY_REVIEW_ALLOWED_ORIGINS=["https://<app>.vercel.app"]
# PRIVACY_REVIEW_ACTIVE_KEY_ID=prod-v1
# PRIVACY_REVIEW_CONTENT_KEYS={"prod-v1":"REPLACE_WITH_GENERATED_FERNET_KEY"}
# PRIVACY_REVIEW_REGISTRATION_ENABLED=false
# PRIVACY_REVIEW_TRUSTED_PROXY_HOPS=1
# PRIVACY_REVIEW_DATABASE_CONNECT_TIMEOUT=10
