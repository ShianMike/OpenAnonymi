# Copy this file to .env and set values for your local PostgreSQL instance.
# Do not use these placeholders as production credentials.
PRIVACY_REVIEW_DATABASE_URL=postgresql+psycopg://review:change-me@127.0.0.1:5432/review
PRIVACY_REVIEW_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PRIVACY_REVIEW_ENVIRONMENT=development
# Before enabling document intake, generate a Fernet key outside this repository
# and set both variables. Example command:
# .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PRIVACY_REVIEW_ACTIVE_KEY_ID=local-v1
# PRIVACY_REVIEW_CONTENT_KEYS={"local-v1":"REPLACE_WITH_GENERATED_FERNET_KEY"}
